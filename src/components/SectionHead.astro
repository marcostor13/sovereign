---
/** Encabezado de sección: número editorial, antetítulo, título y entradilla. */
interface Props {
  index?: string;
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'start' | 'center';
  size?: 'md' | 'lg';
  class?: string;
}

const {
  index,
  eyebrow,
  title,
  lead,
  align = 'start',
  size = 'md',
  class: className = '',
} = Astro.props;
---

<header class:list={['sec-head', `is-${align}`, className]} data-reveal>
  {(index || eyebrow) && (
    <p class="sec-meta">
      {index && <span class="sec-index">{index}</span>}
      {eyebrow && <span class="sec-eyebrow">{eyebrow}</span>}
    </p>
  )}

  <h2 class:list={['sec-title', size === 'lg' ? 'display' : 'title']}>
    <Fragment set:html={title.replace(/™/g, '<sup>™</sup>')} />
  </h2>

  {lead && <p class="lead sec-lead">{lead}</p>}

  <i class="sec-rule draw-line" aria-hidden="true"></i>
</header>

<style>
  .sec-head {
    display: grid;
    gap: clamp(0.9rem, 1.8vw, 1.3rem);
    max-width: 54rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .sec-head.is-center {
    justify-items: center;
    text-align: center;
    margin-inline: auto;
  }

  .sec-meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: var(--step--2);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    line-height: 1;
  }

  .sec-index {
    font-family: var(--font-display);
    font-size: var(--step-0);
    letter-spacing: 0.08em;
    color: var(--gold-600);
    padding-right: 0.9rem;
    border-right: 1px solid var(--hair-strong);
  }

  .sec-eyebrow { color: var(--accent); font-weight: 500; }

  .sec-title {
    color: var(--fg);
    text-wrap: balance;
  }

  .sec-title :global(sup) {
    font-size: 0.42em;
    vertical-align: super;
    letter-spacing: 0;
  }

  .sec-lead { color: var(--fg-muted); }

  .sec-rule {
    width: clamp(4rem, 10vw, 7rem);
    height: 1px;
    margin-top: 0.4rem;
    background: linear-gradient(90deg, var(--gold-500), transparent);
    transition-delay: 200ms;
  }

  .is-center .sec-rule {
    background: linear-gradient(90deg, transparent, var(--gold-500), transparent);
    transform-origin: center;
  }
</style>
