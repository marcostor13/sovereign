---
/**
 * Marca Sovereign Capital Solutions.
 * El medallón se reconstruye como SVG vectorial —mismo emblema, misma paleta—
 * para que sea nítido en cualquier tamaño y animable en el encabezado.
 */
interface Props {
  variant?: 'full' | 'mark' | 'stacked';
  size?: number;
  class?: string;
  /** Título accesible; se omite cuando el logo es puramente decorativo. */
  label?: string;
}

const { variant = 'full', size = 44, class: className = '', label = 'Sovereign Capital Solutions' } = Astro.props;
---

{/* `--mark-base` es el tamaño pedido; `--mark-size` es el efectivo, para que
    las media queries de abajo puedan reducirlo sin pelear con el estilo en
    línea (que siempre ganaría). */}
<span class:list={['logo', `logo-${variant}`, className]} style={`--mark-base:${size}px`}>
  <svg class="logo-mark" viewBox="0 0 100 100" role="img" aria-label={label} fill="none">
    <defs>
      <linearGradient id="sov-gold" x1="12" y1="6" x2="88" y2="94" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#A8862F" />
        <stop offset="0.35" stop-color="#E0C377" />
        <stop offset="0.55" stop-color="#F6ECD2" />
        <stop offset="0.75" stop-color="#D4AF4F" />
        <stop offset="1" stop-color="#A8862F" />
      </linearGradient>
    </defs>

    <g stroke="url(#sov-gold)" stroke-linejoin="round">
      <circle cx="50" cy="50" r="45" stroke-width="2.6" />
      <circle cx="50" cy="50" r="40.5" stroke-width="0.7" opacity="0.5" />

      {/* Roseta de ocho pétalos: cuatro mayores en los ejes, cuatro menores en las diagonales */}
      <g stroke-width="2.1">
        {[0, 90, 180, 270].map((deg) => (
          <path d="M50 18.5 C62.5 31.5 62.5 42.5 50 50 C37.5 42.5 37.5 31.5 50 18.5 Z" transform={`rotate(${deg} 50 50)`} />
        ))}
      </g>
      <g stroke-width="1.5" opacity="0.95">
        {[45, 135, 225, 315].map((deg) => (
          <path d="M50 27 C58 36.5 58 44.5 50 50 C42 44.5 42 36.5 50 27 Z" transform={`rotate(${deg} 50 50)`} />
        ))}
      </g>
    </g>

    <circle cx="50" cy="50" r="3.6" fill="url(#sov-gold)" />
  </svg>

  {variant !== 'mark' && (
    <span class="logo-type">
      <span class="logo-name">Sovereign</span>
      <span class="logo-sub">
        <i class="logo-rule" aria-hidden="true"></i>
        Capital Solutions
        <i class="logo-rule" aria-hidden="true"></i>
      </span>
    </span>
  )}
</span>

<style>
  .logo {
    --mark-size: var(--mark-base);
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    line-height: 1;
    color: var(--gold-400);
  }

  .logo-mark {
    width: var(--mark-size);
    height: var(--mark-size);
    flex: none;
    transition: transform 900ms var(--ease);
  }

  .logo:hover .logo-mark { transform: rotate(45deg); }

  .logo-type {
    display: flex;
    flex-direction: column;
    gap: 0.32em;
  }

  .logo-name {
    font-family: var(--font-roman);
    font-size: calc(var(--mark-size) * 0.5);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--gold-gradient);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    white-space: nowrap;
  }

  .logo-sub {
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-family: var(--font-sans);
    font-size: calc(var(--mark-size) * 0.185);
    font-weight: 400;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    color: var(--bone-200);
    white-space: nowrap;
  }

  .logo-rule {
    width: 0.9em;
    height: 1px;
    background: var(--hair-strong);
    flex: none;
  }

  .logo-sub .logo-rule:first-child { display: none; }

  /* Variante apilada, centrada: pie de página y portada */
  .logo-stacked {
    flex-direction: column;
    gap: 1.1em;
    text-align: center;
  }

  .logo-stacked .logo-type { align-items: center; gap: 0.5em; }
  .logo-stacked .logo-name { font-size: calc(var(--mark-size) * 0.62); letter-spacing: 0.18em; }
  .logo-stacked .logo-sub { font-size: calc(var(--mark-size) * 0.2); }
  .logo-stacked .logo-sub .logo-rule:first-child { display: block; }

  .on-light .logo-sub { color: var(--ink-700); }

  @media (max-width: 560px) {
    .logo-full { --mark-size: min(var(--mark-base), 38px); gap: 0.55em; }
    .logo-full .logo-sub { letter-spacing: 0.2em; }
  }

  @media (max-width: 380px) {
    .logo-full { --mark-size: min(var(--mark-base), 34px); }
  }
</style>
