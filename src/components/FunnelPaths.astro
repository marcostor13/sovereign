---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';

/**
 * Puerta de entrada a los dos embudos desde el sitio institucional. Dos
 * productos distintos, dos caminos distintos: nunca se mezclan.
 */
const paths = [
  {
    href: '/iul',
    tag: 'Seguro de vida universal indexado',
    title: 'IUL sin mitos',
    text: 'Protección de por vida y valor en efectivo con piso de 0% frente a caídas del índice (los cargos siguen aplicando). Para profesionales y familias que piensan en retiro y legado.',
    cta: 'Hacer el diagnóstico de 2 minutos',
    points: ['Simulador de cap, floor y participación', 'Quién sí y quién no', 'Resultado al instante'],
  },
  {
    href: '/banca-mia',
    tag: 'Estrategia con seguro de vida Whole Life',
    title: 'Banca Mía™ para empresarios',
    text: 'Una reserva de capital contractual para planear compras de equipo, inventario o vehículos. No es un banco ni una cuenta bancaria; los dividendos no están garantizados.',
    cta: 'Ver la masterclass gratuita',
    points: ['38 minutos, en español', 'Los mitos de la Banca Infinita', 'Diagnóstico de Capital sin costo'],
  },
];
---

<section class="section section-deep paths" aria-labelledby="paths-title">
  <div class="shell">
    <SectionHead
      eyebrow="Educación antes que venta"
      title="Dos herramientas distintas. Entiende la tuya antes de decidir."
      lead="Explicamos cada estrategia con sus ventajas, sus costos y en qué casos NO conviene. Elige por dónde empezar."
    />

    <ul class="paths-grid" data-reveal-group data-stagger="120">
      {paths.map((p) => (
        <li data-reveal-item data-reveal>
          <a class="paths-card card" href={p.href}>
            <span class="paths-tag">{p.tag}</span>
            <h3><Fragment set:html={p.title.replace(/™/g, '<sup>™</sup>')} /></h3>
            <p>{p.text}</p>
            <ul class="paths-points">
              {p.points.map((pt) => <li><Icon name="check" size={14} stroke={2} />{pt}</li>)}
            </ul>
            <span class="link-arrow paths-cta">{p.cta}<Icon name="arrow" size={15} /></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .paths-grid {
    display: grid;
    gap: clamp(1rem, 2vw, 1.6rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .paths-grid > li { height: 100%; }

  .paths-card { height: 100%; gap: 1rem; }

  .paths-tag { font-size: var(--step--2); letter-spacing: var(--tracking-wider); text-transform: uppercase; color: var(--accent); }

  .paths-card h3 { font-size: var(--step-3); color: var(--fg); }
  .paths-card h3 :global(sup) { font-size: 0.45em; vertical-align: super; }

  .paths-card > p { font-size: var(--step-0); line-height: 1.7; color: var(--fg-muted); }

  .paths-points { display: grid; gap: 0.45rem; list-style: none; padding: 0; margin: 0; }
  .paths-points li { display: flex; align-items: center; gap: 0.55em; font-size: var(--step--1); color: var(--bone-200); }
  .paths-points :global(svg) { color: var(--gold-400); }

  .paths-cta { margin-top: auto; padding-top: 0.6rem; }
</style>
