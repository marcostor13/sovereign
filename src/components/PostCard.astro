---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import PostPlate from './PostPlate.astro';
import { academySection, cta } from '../data/site';

interface Props {
  post: CollectionEntry<'posts'>;
  size?: 'md' | 'lg';
}

const { post, size = 'md' } = Astro.props;

// Formato corto: en el pie de la tarjeta la fecha larga partía en dos líneas.
const formatted = post.data.date.toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<article class:list={['post card', `is-${size}`]} data-category={post.data.category}>
  <a class="post-link" href={`/academia/${post.id}`}>
    <PostPlate seed={post.id} ratio={size === 'lg' ? '16 / 9' : '16 / 10'} class="post-plate" />

    <div class="post-body">
      <p class="post-meta">
        <span class="post-cat">{post.data.category}</span>
        <span class="post-dot" aria-hidden="true"></span>
        <span>{post.data.read} {academySection.minRead}</span>
      </p>

      <h3 class="post-title">{post.data.title}</h3>
      <p class="post-excerpt">{post.data.excerpt}</p>

      <p class="post-foot">
        <span class="link-arrow">{cta.read}<Icon name="arrow" size={15} /></span>
        <time datetime={post.data.date.toISOString()}>{formatted}</time>
      </p>
    </div>
  </a>
</article>

<style>
  .post { padding: 0; overflow: hidden; height: 100%; }

  .post-link { display: flex; flex-direction: column; height: 100%; }

  .post-plate { border-bottom: 1px solid var(--hair-soft); }

  .post-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
    padding: clamp(1.3rem, 2.2vw, 1.9rem);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: var(--step--2);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--fg-dim);
  }

  .post-cat { color: var(--accent); font-weight: 500; }

  .post-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.6;
  }

  .post-title {
    font-size: var(--step-2);
    line-height: 1.2;
    color: var(--fg);
    transition: color var(--dur) var(--ease);
  }

  .post:hover .post-title { color: var(--gold-300); }

  .post-excerpt {
    flex: 1;
    font-size: var(--step--1);
    line-height: 1.65;
    color: var(--fg-muted);
  }

  .post-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.9rem;
    margin-top: 0.2rem;
    border-top: 1px solid var(--hair-soft);
    font-size: var(--step--2);
    color: var(--fg-dim);
    white-space: nowrap;
  }

  .post-foot :global(.link-arrow) { white-space: nowrap; }

  .is-lg .post-title { font-size: var(--step-3); }
  .is-lg .post-excerpt { font-size: var(--step-0); }
  .is-lg .post-body { padding: clamp(1.6rem, 2.8vw, 2.4rem); }

  /* Sobre fondo claro, la lámina mantiene su contraste propio */
  .on-light .post-title { color: var(--ink-900); }
  .on-light .post:hover .post-title { color: var(--gold-700); }
  .on-light .post-excerpt { color: var(--ink-500); }
  .on-light .post-meta,
  .on-light .post-foot { color: #6e7887; }
  .on-light .post-cat { color: var(--gold-700); }
</style>
