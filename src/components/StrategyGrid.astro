---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { strategiesSection, cta } from '../data/site';

interface Props {
  /** Oculta el encabezado cuando la sección ya vive dentro de una página propia. */
  bare?: boolean;
  /** Excluye una estrategia (útil en la vista de detalle). */
  exclude?: string;
  title?: string;
}

const { bare = false, exclude, title } = Astro.props;

const all = await getCollection('strategies');
const items = all
  .filter((s) => s.id !== exclude)
  .sort((a, b) => a.data.order - b.data.order);
---

<section class:list={['section section-light on-light', bare && 'is-bare']} id="estrategias">
  <div class="shell">
    {!bare && (
      <SectionHead
        index={strategiesSection.index}
        eyebrow={strategiesSection.eyebrow}
        title={title ?? strategiesSection.title}
        lead={strategiesSection.lead}
        align="center"
        size="lg"
      />
    )}

    <ul class="str-grid" data-reveal-group data-stagger="80">
      {items.map((item) => (
        <li
          class:list={['str-card card', item.data.featured && 'is-featured']}
          data-reveal-item
          data-reveal
        >
          <a href={`/estrategias/${item.id}`} class="str-link">
            <span class="str-icon"><Icon name={item.data.icon} size={28} stroke={1.1} /></span>

            <h3 class="str-title">
              <Fragment set:html={item.data.title.replace(/™/g, '<sup>™</sup>')} />
            </h3>

            <p class="str-text">{item.data.short}</p>

            <span class="link-arrow str-more">
              {cta.more}
              <Icon name="arrow" size={15} />
            </span>
          </a>

          <i class="str-sweep" aria-hidden="true"></i>
        </li>
      ))}
    </ul>

    {!bare && (
      <div class="str-foot" data-reveal>
        <a class="btn btn-outline" href="/estrategias">
          {cta.allStrategies}
          <Icon name="arrow" size={16} />
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .is-bare { padding-top: 0; }

  .str-grid {
    display: grid;
    gap: clamp(1rem, 1.6vw, 1.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .str-card { padding: 0; overflow: hidden; }

  .str-link {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    padding: clamp(1.7rem, 2.6vw, 2.3rem);
  }

  .str-icon {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    color: var(--gold-600);
    border: 1px solid rgba(201, 162, 39, 0.35);
    border-radius: var(--radius-sm);
    transition: transform var(--dur) var(--ease), color var(--dur) var(--ease),
                border-color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }

  .str-card:hover .str-icon {
    background: var(--gold-500);
    border-color: var(--gold-500);
    color: var(--navy-950);
    transform: rotate(-8deg);
  }

  .str-title {
    font-size: var(--step-2);
    color: var(--ink-900);
    line-height: 1.18;
  }

  .str-title :global(sup) { font-size: 0.4em; vertical-align: super; }

  .str-text {
    flex: 1;
    font-size: var(--step--1);
    line-height: 1.65;
    color: var(--ink-500);
  }

  .str-more { margin-top: 0.3rem; }

  .str-sweep {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 100%;
    background: var(--gold-gradient);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 520ms var(--ease);
  }

  .str-card:hover .str-sweep { transform: scaleX(1); }

  /* Banca Mía™ es la metodología propia: se destaca invirtiendo el color */
  .str-card.is-featured {
    background: linear-gradient(165deg, var(--navy-800), var(--navy-950));
    border-color: var(--hair-strong);
  }

  .is-featured .str-title { color: #fff; }
  .is-featured .str-text { color: var(--fg-muted); }
  .is-featured .str-icon { color: var(--gold-400); border-color: var(--hair-strong); }

  .is-featured::after {
    content: 'Metodología propia';
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--gold-400);
    border: 1px solid var(--hair-strong);
    border-radius: 999px;
    padding: 0.35em 0.85em;
  }

  .str-foot {
    display: flex;
    justify-content: center;
    margin-top: clamp(2.2rem, 4vw, 3.2rem);
  }

  @media (min-width: 1100px) {
    .str-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
