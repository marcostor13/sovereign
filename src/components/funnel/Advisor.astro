---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { agent, licenseLines, licensedStatesText } from '../../data/compliance';

/**
 * "Quién te asesora": en seguros se le compra a una persona. Foto, licencia
 * verificable y un enfoque explícito. Se usa en las landings y en la portada.
 */
interface Props {
  eyebrow?: string;
  title?: string;
  bio?: string;
  quote?: string;
  tone?: 'light' | 'dark';
}

const {
  eyebrow = 'Quién te asesora',
  title = agent.name,
  bio = agent.bio,
  quote = agent.quoteIul,
  tone = 'light',
} = Astro.props;

const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/img/founder.{jpg,jpeg,png,webp}', { eager: true });
const photo = Object.values(photos)[0]?.default;
---

<div class:list={['adv', `is-${tone}`]}>
  <div class="adv-media">
    {photo ? (
      <Image
        src={photo}
        alt={`${agent.name}, ${agent.title.toLowerCase()} de Sovereign Capital Solutions`}
        widths={[360, 540, 720]}
        sizes="(min-width: 900px) 22rem, calc(100vw - 32px)"
        loading="lazy"
        quality={80}
        format="avif"
      />
    ) : (
      <div class="adv-plate" aria-hidden="true">SC</div>
    )}
  </div>

  <div class="adv-copy">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="adv-name">{title}</h2>
    <p class="adv-role">{agent.role} · {agent.title} en {licensedStatesText}</p>

    <ul class="adv-facts">
      {agent.npn && <li><Icon name="shield" size={16} />NPN {agent.npn}</li>}
      {licenseLines.map((l) => <li><Icon name="doc" size={16} />Licencia {l}</li>)}
      <li><Icon name="user" size={16} />{agent.languages.join(' · ')}</li>
    </ul>

    <p class="adv-bio">{bio}</p>

    <blockquote class="adv-quote">“{quote}”</blockquote>

    <a class="adv-verify" href={agent.verifyUrl} target="_blank" rel="noopener noreferrer">
      {agent.verifyLabel}
      <Icon name="external" size={14} />
    </a>
  </div>
</div>

<style>
  .adv { display: grid; gap: clamp(1.8rem, 4vw, 3.5rem); align-items: center; }

  .adv-media :global(img), .adv-plate {
    width: 100%;
    max-width: 22rem;
    /* Sin height: auto, el atributo height del <Image> (px intrínsecos) gana a
       aspect-ratio y la foto queda como una tira recortada. */
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 25%;
    border-radius: 14px;
    box-shadow: 0 30px 60px -40px rgba(3, 7, 16, 0.8);
  }

  .adv-plate {
    display: grid;
    place-items: center;
    background: linear-gradient(160deg, var(--navy-800), var(--navy-990));
    font-family: var(--font-roman);
    font-size: 3.5rem;
    color: var(--gold-500);
  }

  .adv-copy { display: grid; gap: 0.8rem; max-width: 40rem; }

  .adv-name { font-size: var(--step-4); line-height: 1.05; }

  .adv-role { font-size: var(--step--1); letter-spacing: 0.02em; }

  .adv-facts { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 0.2rem 0; }

  .adv-facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.35rem 0.75rem;
    border-radius: 99px;
    font-size: var(--step--1);
  }

  .adv-bio { font-size: var(--step-0); line-height: 1.7; }

  .adv-quote {
    padding-left: 1rem;
    border-left: 2px solid var(--gold-500);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-style: italic;
    line-height: 1.3;
  }

  .adv-verify {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    justify-self: start;
    min-height: 44px;
    font-size: var(--step--1);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Tonos */
  .is-light .adv-name { color: var(--ink-900); }
  .is-light .adv-role, .is-light .adv-bio { color: var(--ink-500); }
  .is-light .adv-facts li { background: #fff; border: 1px solid rgba(10, 22, 40, 0.1); color: var(--ink-700); }
  .is-light .adv-facts :global(svg) { color: var(--gold-700); }
  .is-light .adv-quote { color: var(--ink-900); }
  .is-light .adv-verify { color: var(--navy-600); }

  .is-dark .adv-name { color: var(--fg); }
  .is-dark .adv-role, .is-dark .adv-bio { color: var(--fg-muted); }
  .is-dark .adv-facts li { border: 1px solid var(--hair); color: var(--bone-200); }
  .is-dark .adv-facts :global(svg) { color: var(--gold-400); }
  .is-dark .adv-quote { color: var(--bone-100); }
  .is-dark .adv-verify { color: var(--gold-300); }

  @media (min-width: 900px) {
    .adv { grid-template-columns: 22rem minmax(0, 1fr); }
  }
</style>
