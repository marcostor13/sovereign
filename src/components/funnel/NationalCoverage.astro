---
import Icon from '../Icon.astro';
import type { IconName } from '../../data/site';
import { agency, coverage, licensedStates } from '../../data/compliance';

/**
 * "Cobertura nacional": el tráfico de anuncios llega de todo el país y la
 * primera duda antes del formulario es "¿me pueden atender si vivo en Texas?".
 * Mapa de mosaicos (un cuadro por estado) con la oficina marcada, tres razones
 * concretas y la advertencia de disponibilidad por estado.
 */
interface Props {
  title: string;
  lead: string;
  ctaHref: string;
  ctaLabel: string;
}

const { title, lead, ctaHref, ctaLabel } = Astro.props;

/** [código, columna, fila] sobre una retícula de 11 × 8. */
const tiles: [string, number, number][] = [
  ['AK', 0, 0], ['ME', 10, 0],
  ['VT', 9, 1], ['NH', 10, 1],
  ['WA', 0, 2], ['ID', 1, 2], ['MT', 2, 2], ['ND', 3, 2], ['MN', 4, 2], ['IL', 5, 2], ['WI', 6, 2], ['MI', 7, 2], ['NY', 8, 2], ['RI', 9, 2], ['MA', 10, 2],
  ['OR', 0, 3], ['NV', 1, 3], ['WY', 2, 3], ['SD', 3, 3], ['IA', 4, 3], ['IN', 5, 3], ['OH', 6, 3], ['PA', 7, 3], ['NJ', 8, 3], ['CT', 9, 3],
  ['CA', 0, 4], ['UT', 1, 4], ['CO', 2, 4], ['NE', 3, 4], ['MO', 4, 4], ['KY', 5, 4], ['WV', 6, 4], ['VA', 7, 4], ['MD', 8, 4], ['DE', 9, 4],
  ['AZ', 1, 5], ['NM', 2, 5], ['KS', 3, 5], ['AR', 4, 5], ['TN', 5, 5], ['NC', 6, 5], ['SC', 7, 5], ['DC', 8, 5],
  ['OK', 3, 6], ['LA', 4, 6], ['MS', 5, 6], ['AL', 6, 6], ['GA', 7, 6],
  ['HI', 0, 7], ['TX', 3, 7], ['FL', 8, 7],
];

const points: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'shield',
    title: `Licencia en ${coverage.short}`,
    text: `Licencia de residente en Florida y de no residente en el resto del país, verificable en los registros públicos de cada estado.`,
  },
  {
    icon: 'calendar',
    title: 'Consulta por videollamada',
    text: `Desde tu casa o tu negocio, en español o inglés, sin costo. Si estás en el sur de Florida, también en nuestra oficina.`,
  },
  {
    icon: 'doc',
    title: 'Aseguradoras autorizadas en tu estado',
    text: 'La póliza se emite conforme a las reglas de tu estado y la revisamos contigo cada año, vivas donde vivas.',
  },
];
---

<section class="lp-section lp-dark nc" aria-labelledby="nc-title">
  <div class="lp-shell nc-grid">
    <header class="lp-head nc-head">
        <p class="lp-eyebrow">Cobertura nacional</p>
        <h2 class="lp-h2" id="nc-title">{title}</h2>
        <p class="lp-lead">{lead}</p>
    </header>

    <div class="nc-body">
      <ul class="nc-points">
        {points.map((p) => (
          <li>
            <Icon name={p.icon} size={22} stroke={1.3} />
            <span>
              <strong>{p.title}</strong>
              {p.text}
            </span>
          </li>
        ))}
      </ul>

      <div class="lp-actions nc-actions">
        <a class="btn btn-gold btn-lg" href={ctaHref} data-cta="coverage">
          {ctaLabel}
          <Icon name="arrow" size={17} />
        </a>
      </div>
    </div>

    <figure class="nc-map">
      <ol class="nc-tiles" aria-label={`Estados con licencia vigente: ${coverage.long}`}>
        <li class="nc-badge" aria-hidden="true"><b>{licensedStates.filter((c) => c !== 'DC').length}</b><span>estados<br />+ DC</span></li>
        {tiles.map(([code, col, row]) => (
          <li
            class:list={['nc-tile', { 'is-home': code === agency.region }]}
            style={`grid-column:${col + 1};grid-row:${row + 1}`}
            aria-hidden="true"
          >
            {code}
          </li>
        ))}
      </ol>
      <figcaption>
        <Icon name="pin" size={15} />
        <span>Oficina: {agency.address}</span>
      </figcaption>
    </figure>
  </div>

  <p class="lp-shell lp-legal nc-legal">
    La disponibilidad de cada producto y de sus características varía según el estado y la aseguradora, y toda póliza está sujeta a aprobación (underwriting). Por ahora no atendemos territorios como Puerto Rico.
  </p>
</section>

<style>
  /* Móvil: titular → mapa → razones. Escritorio: texto a la izquierda, mapa a la derecha. */
  .nc-grid {
    display: grid;
    grid-template-areas: 'head' 'map' 'body';
    gap: 2rem clamp(2.2rem, 5vw, 4rem);
    align-items: center;
  }

  .nc-head { grid-area: head; margin-bottom: 0; }
  .nc-body { grid-area: body; }
  .nc-map { grid-area: map; }

  .nc-points { display: grid; gap: 1.1rem; list-style: none; padding: 0; margin: 0; }

  .nc-points li { display: grid; grid-template-columns: auto 1fr; gap: 0.85rem; align-items: start; }
  .nc-points :global(svg) { color: var(--gold-400); margin-top: 0.15em; }
  .nc-points span { display: grid; gap: 0.2rem; line-height: 1.55; color: var(--fg-muted); }
  .nc-points strong { font-family: var(--font-display); font-size: var(--step-1); font-weight: 500; line-height: 1.25; color: var(--bone-100); }

  .nc-actions { margin-top: 1.8rem; }

  /* --- Mapa ---------------------------------------------------------------- */

  .nc-map {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: clamp(1rem, 3vw, 1.8rem);
    border: 1px solid var(--hair);
    border-radius: 18px;
    background: radial-gradient(80% 70% at 70% 90%, rgba(201, 162, 39, 0.1), transparent 70%), var(--navy-950);
  }

  .nc-tiles {
    display: grid;
    grid-template-columns: repeat(11, minmax(0, 1fr));
    grid-template-rows: repeat(8, auto);
    gap: clamp(3px, 0.6vw, 6px);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nc-tile {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: clamp(3px, 0.5vw, 6px);
    background: rgba(201, 162, 39, 0.16);
    border: 1px solid rgba(201, 162, 39, 0.38);
    font-size: clamp(0.5rem, 1.6vw, 0.72rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--gold-300);
  }

  .nc-tile.is-home {
    background: var(--gold-500);
    border-color: var(--gold-300);
    color: var(--navy-950);
    box-shadow: 0 0 0 3px rgba(201, 162, 39, 0.25);
  }

  /* Ocupa el hueco natural del mapa, entre Alaska y Nueva Inglaterra. */
  .nc-badge {
    grid-column: 3 / 9;
    grid-row: 1 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    line-height: 1.1;
  }

  .nc-badge b { font-family: var(--font-display); font-size: clamp(2rem, 6vw, 3.4rem); font-weight: 500; color: #fff; }
  .nc-badge span { font-size: var(--step--2); letter-spacing: var(--tracking-wider); text-transform: uppercase; color: var(--gold-300); }

  .nc-map figcaption {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--fg-muted);
  }

  .nc-map figcaption :global(svg) { flex: none; margin-top: 0.15em; color: var(--gold-400); }

  .nc-legal { margin-top: clamp(1.8rem, 4vw, 2.6rem); }

  @media (min-width: 1000px) {
    .nc-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      grid-template-areas: 'head map' 'body map';
      row-gap: 1.8rem;
    }
    .nc-head { align-self: end; }
    .nc-body { align-self: start; }
  }
</style>
