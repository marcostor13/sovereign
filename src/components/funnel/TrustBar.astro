---
import Icon from '../Icon.astro';
import type { TrustItem } from '../../data/funnels';
import { coverage, licenseLines } from '../../data/compliance';

interface Props {
  items: TrustItem[];
}

const { items } = Astro.props;
// La primera tarjeta (licencia) muestra el número de residente cuando exista.
const licenseDetail = licenseLines.length ? `Residente ${licenseLines[0]} · ${coverage.short}` : 'y el Distrito de Columbia';
---

<section class="trust" aria-label="Por qué confiar">
  <ul class="shell trust-list">
    {items.map((item, i) => (
      <li>
        <Icon name={item.icon} size={22} stroke={1.3} />
        <span>
          {item.label}
          {(item.detail ?? (i === 0 ? licenseDetail : undefined)) && <small>{item.detail ?? licenseDetail}</small>}
        </span>
      </li>
    ))}
  </ul>
</section>

<style>
  .trust {
    background: var(--navy-900);
    border-block: 1px solid var(--hair);
  }

  .trust-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.2rem;
    padding-block: 1.3rem;
    list-style: none;
    margin-block: 0;
  }

  .trust-list li { display: flex; align-items: center; gap: 0.7rem; min-width: 0; }
  .trust-list :global(svg) { color: var(--gold-400); flex: none; }

  .trust-list span {
    display: grid;
    font-size: var(--step--1);
    line-height: 1.35;
    color: var(--bone-100);
  }

  .trust-list small { font-size: 0.78em; color: var(--fg-muted); letter-spacing: 0.02em; }

  @media (min-width: 900px) {
    .trust-list { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .trust-list li { justify-content: center; }
  }
</style>
