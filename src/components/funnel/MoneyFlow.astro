---
import Icon from '../Icon.astro';
import type { IconName } from '../../data/site';

/** Diagrama de pasos conectados: horizontal en escritorio, vertical en móvil. */
interface Props {
  steps: readonly { icon: IconName; title: string; text: string }[];
}

const { steps } = Astro.props;
---

<ol class="flow" data-reveal-group data-stagger="120">
  {steps.map((s, i) => (
    <li class="flow-step" data-reveal-item data-reveal>
      <span class="flow-node">
        <Icon name={s.icon} size={24} stroke={1.3} />
        <b>{i + 1}</b>
      </span>
      <h3>{s.title}</h3>
      <p>{s.text}</p>
    </li>
  ))}
</ol>

<style>
  .flow { display: grid; gap: 0; list-style: none; padding: 0; margin: 0; counter-reset: flow; }

  .flow-step {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto 1fr;
    column-gap: 1.1rem;
    padding-bottom: 1.8rem;
  }

  /* Conector vertical */
  .flow-step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 1.75rem;
    top: 3.6rem;
    bottom: 0.2rem;
    width: 2px;
    background: linear-gradient(180deg, var(--gold-500), rgba(201, 162, 39, 0.2));
  }

  .flow-node {
    position: relative;
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--navy-850);
    color: var(--gold-300);
    box-shadow: 0 0 0 5px rgba(201, 162, 39, 0.15);
  }

  .flow-node b {
    position: absolute;
    top: -0.3rem;
    right: -0.3rem;
    display: grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    background: var(--gold-500);
    color: var(--navy-950);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .flow-step h3 { align-self: center; font-size: var(--step-2); color: var(--ink-900); }
  .flow-step p { font-size: var(--step-0); line-height: 1.6; color: var(--ink-500); margin-top: 0.3rem; }

  @media (min-width: 900px) {
    .flow { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.4rem; }

    .flow-step { grid-template-columns: 1fr; grid-template-rows: auto; row-gap: 0.4rem; padding-bottom: 0; }

    .flow-node { grid-row: auto; margin-bottom: 0.8rem; }

    .flow-step:not(:last-child)::after {
      left: 4.5rem;
      right: -0.4rem;
      top: 1.75rem;
      bottom: auto;
      width: auto;
      height: 2px;
      background: linear-gradient(90deg, var(--gold-500), rgba(201, 162, 39, 0.2));
    }
  }
</style>
