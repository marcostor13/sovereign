---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { agent } from '../../data/compliance';

/**
 * Video del asesor con "facade": sólo se muestra la foto y el botón de play;
 * el reproductor de Vimeo se carga al hacer clic (no pesa en el LCP).
 * Sin `videoId` queda la fotografía del asesor, que es la variante "foto" del
 * test A/B del hero.
 */
interface Props {
  videoId?: string;
  caption: string;
}

const { videoId, caption } = Astro.props;

const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/img/founder.{jpg,jpeg,png,webp}', { eager: true });
const photo = Object.values(photos)[0]?.default;
---

<figure class="vf" data-video-facade data-video-id={videoId}>
  <div class="vf-frame">
    {photo && (
      <Image
        src={photo}
        alt={`${agent.name}, asesor de Sovereign Capital Solutions`}
        widths={[420, 640, 860]}
        sizes="(min-width: 1000px) 30rem, 90vw"
        loading="eager"
        fetchpriority="high"
        quality={78}
        format="avif"
      />
    )}

    {videoId && (
      <button class="vf-play" type="button" data-video-play aria-label={`Reproducir: ${caption}`}>
        <Icon name="play" size={64} stroke={1} />
      </button>
    )}
  </div>

  <figcaption class="vf-caption">
    <span class="vf-name">{agent.name}</span>
    <span>{videoId ? caption : `${agent.title} · ${agent.role}`}</span>
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-video-facade]').forEach((fig) => {
    const id = fig.dataset.videoId;
    const btn = fig.querySelector('[data-video-play]');
    if (!id || !btn) return;

    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://player.vimeo.com/video/${encodeURIComponent(id)}?autoplay=1&texttrack=es&dnt=1`;
      iframe.allow = 'autoplay; fullscreen; picture-in-picture';
      iframe.title = fig.querySelector('.vf-caption')?.textContent?.trim() || 'Video';
      fig.querySelector('.vf-frame')!.replaceChildren(iframe);
    });
  });
</script>

<style>
  .vf { margin: 0; display: grid; gap: 0.8rem; }

  .vf-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 16px;
    overflow: hidden;
    background: var(--navy-800);
    box-shadow: 0 40px 80px -40px rgba(3, 7, 16, 0.95);
    border: 1px solid var(--hair);
  }

  .vf-frame :global(img), .vf-frame :global(iframe) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%; border: 0; }

  .vf-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    background: linear-gradient(180deg, transparent 40%, rgba(3, 7, 16, 0.55));
    transition: background-color var(--dur) var(--ease);
  }

  .vf-play :global(svg) { filter: drop-shadow(0 6px 20px rgba(0, 0, 0, 0.5)); transition: transform var(--dur) var(--ease); }
  .vf-play:hover :global(svg) { transform: scale(1.08); color: var(--gold-300); }

  .vf-caption { display: grid; gap: 0.1rem; font-size: var(--step--1); color: var(--fg-muted); }
  .vf-name { font-family: var(--font-display); font-size: var(--step-1); color: var(--bone-100); }
</style>
