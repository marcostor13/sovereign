const isSolid = name in solid;
const markup = isSolid ? solid[name] : line[name];
const dim = typeof size === 'number' ? `${size}px` : size;
---

{markup && (
  <svg
    class:list={['icon', className]}
    width={dim}
    height={dim}
    viewBox="0 0 24 24"
    fill={isSolid ? 'currentColor' : 'none'}
    stroke={isSolid ? 'none' : 'currentColor'}
    stroke-width={isSolid ? undefined : stroke}
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    set:html={markup}
  />
)}

<style>
  .icon { flex: none; overflow: visible; }
</style>
