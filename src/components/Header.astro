---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, cta, contact, ui, values } from '../data/site';

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const isActive = (href: string) => {
  const base = href.split('#')[0].replace(/\/+$/, '') || '/';
  return base === '/' ? path === '/' : path === base || path.startsWith(`${base}/`);
};
---

<header class:list={['header', transparent && 'is-transparent']} data-header>
  <div class="header-inner shell">
    <a class="header-logo" href="/" aria-label="Sovereign Capital Solutions — Inicio">
      <Logo size={46} />
    </a>

    <nav class="header-nav" aria-label="Navegación principal">
      <ul class="nav-list">
        {nav.map((item) => (
          <li class:list={['nav-item', item.children && 'has-children']}>
            <a href={item.href} class:list={['nav-link', isActive(item.href) && 'is-active']}>
              {item.label}
              {item.children && <Icon name="chevron" size={13} stroke={1.6} class="nav-caret" />}
            </a>

            {item.children && (
              <div class="mega" role="group">
                <div class="mega-inner">
                  <p class="mega-title">{item.label}</p>
                  <ul class="mega-list">
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href} class="mega-link">
                          <span class="mega-link-label">{child.label}</span>
                          {child.desc && <span class="mega-link-desc">{child.desc}</span>}
                          <Icon name="arrow" size={15} class="mega-arrow" />
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a class="header-phone" href={contact.phoneHref} aria-label={`Llamar al ${contact.phone}`}>
        <Icon name="phone" size={15} />
        <span>{contact.phone}</span>
      </a>

      <a class="btn btn-outline header-cta" href="/contacto">
        <Icon name="calendar" size={15} />
        <span>{cta.primaryShort}</span>
      </a>

      <button class="burger" type="button" aria-expanded="false" aria-controls="site-drawer" data-burger>
        <span class="visually-hidden">{ui.menu}</span>
        <span class="burger-bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="header-edge" aria-hidden="true"></div>
</header>

{/* --- Panel móvil ------------------------------------------------------- */}
<div class="drawer" id="site-drawer" data-drawer hidden>
  <div class="drawer-scrim" data-drawer-close></div>

  <div class="drawer-panel grain" role="dialog" aria-modal="true" aria-label={ui.menu}>
    <div class="drawer-head">
      <Logo size={38} />
      <button class="drawer-close" type="button" data-drawer-close>
        <span class="visually-hidden">{ui.close}</span>
        <Icon name="close" size={20} />
      </button>
    </div>

    <nav class="drawer-nav" aria-label="Navegación móvil">
      <ul>
        {nav.map((item, i) => (
          <li class="drawer-item" style={`--i:${i}`}>
            {item.children ? (
              <details name="drawer-group">
                <summary>
                  <span>{item.label}</span>
                  <Icon name="plus" size={17} class="drawer-plus" />
                </summary>
                <ul class="drawer-sub">
                  <li><a href={item.href}>Ver todo</a></li>
                  {item.children.map((child) => (
                    <li><a href={child.href}>{child.label}</a></li>
                  ))}
                </ul>
              </details>
            ) : (
              <a class="drawer-link" href={item.href}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="drawer-foot">
      <a class="btn btn-gold btn-block" href="/contacto">
        {cta.primaryShort}
        <Icon name="arrow" size={16} />
      </a>

      <div class="drawer-contact">
        <a href={contact.phoneHref}><Icon name="phone" size={15} />{contact.phone}</a>
        <a href={`mailto:${contact.email}`}><Icon name="mail" size={15} />{contact.email}</a>
      </div>

      <p class="drawer-values">{values.join(' · ')}</p>
    </div>
  </div>
</div>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    background: rgba(5, 12, 22, 0.92);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    transition: transform 520ms var(--ease), background-color 420ms var(--ease),
                backdrop-filter 420ms var(--ease);
  }

  .header.is-transparent {
    background: linear-gradient(180deg, rgba(3, 7, 16, 0.72), transparent);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .header.is-transparent.is-scrolled {
    background: rgba(5, 12, 22, 0.94);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
  }

  .header.is-hidden { transform: translateY(-100%); }

  .header-edge {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--hair-strong) 22%, var(--hair-strong) 78%, transparent);
    opacity: 0;
    transition: opacity 420ms var(--ease);
  }

  .header.is-scrolled .header-edge { opacity: 1; }
  .header:not(.is-transparent) .header-edge { opacity: 1; }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    height: var(--header-h);
    transition: height 420ms var(--ease);
  }

  .header.is-scrolled .header-inner { height: var(--header-h-scrolled); }

  .header-logo { flex: none; }

  .header.is-scrolled :global(.logo-mark) { width: 38px; height: 38px; }

  /* --- Navegación de escritorio ---------------------------------------- */

  .header-nav { display: none; }

  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(0.35rem, 1vw, 1.15rem);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-item { position: relative; }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.65rem 0.2rem;
    font-size: var(--step--2);
    font-weight: 450;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--bone-200);
    white-space: nowrap;
    transition: color var(--dur) var(--ease);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.2rem;
    right: 0.2rem;
    bottom: 0.3rem;
    height: 1px;
    background: var(--gold-500);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur) var(--ease);
  }

  .nav-link:hover,
  .nav-link.is-active { color: var(--gold-300); }

  .nav-link:hover::after,
  .nav-link.is-active::after { transform: scaleX(1); transform-origin: left; }

  .nav-caret { transition: transform var(--dur) var(--ease); opacity: 0.7; }
  .has-children:hover .nav-caret { transform: rotate(180deg); }

  /* --- Panel desplegable ------------------------------------------------ */

  .mega {
    position: absolute;
    top: 100%;
    left: 50%;
    translate: -50% 0;
    padding-top: 0.9rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 300ms var(--ease), transform 300ms var(--ease), visibility 300ms;
    pointer-events: none;
  }

  .has-children:hover .mega,
  .has-children:focus-within .mega {
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
  }

  .mega-inner {
    min-width: 22rem;
    padding: 1.4rem;
    background: linear-gradient(165deg, var(--navy-800), var(--navy-950));
    border: 1px solid var(--hair);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }

  .mega-title {
    margin-bottom: 0.9rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--hair-soft);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent);
  }

  .mega-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.15rem; }

  .mega-link {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.2rem 1rem;
    padding: 0.7rem 0.85rem;
    border-radius: var(--radius-sm);
    transition: background-color var(--dur) var(--ease);
  }

  .mega-link:hover { background: rgba(201, 162, 39, 0.09); }

  .mega-link-label {
    font-size: var(--step--1);
    font-weight: 450;
    color: var(--fg);
  }

  .mega-link-desc {
    grid-column: 1;
    font-size: var(--step--2);
    color: var(--fg-dim);
    line-height: 1.4;
  }

  .mega-arrow {
    grid-row: 1 / span 2;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .mega-link:hover .mega-arrow { opacity: 1; transform: none; }

  /* --- Acciones --------------------------------------------------------- */

  .header-actions {
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 1.5vw, 1.4rem);
    flex: none;
  }

  .header-phone {
    display: none;
    align-items: center;
    gap: 0.5em;
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    color: var(--fg-muted);
    transition: color var(--dur) var(--ease);
  }

  .header-phone:hover { color: var(--gold-300); }

  .header-cta {
    --btn-py: 0.95em;
    --btn-px: 1.25em;
    font-size: var(--step--2);
    letter-spacing: 0.09em;
    line-height: 1;
    white-space: nowrap;
  }

  /* --- Botón hamburguesa ------------------------------------------------ */

  .burger {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--hair);
    border-radius: var(--radius-sm);
    transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }

  .burger:hover { border-color: var(--hair-strong); background: rgba(201, 162, 39, 0.07); }

  .burger-bars { display: grid; gap: 5px; width: 20px; }

  .burger-bars i {
    height: 1.5px;
    background: var(--gold-300);
    transition: transform 380ms var(--ease), width 380ms var(--ease);
  }

  .burger-bars i:last-child { width: 13px; justify-self: end; }
  .burger:hover .burger-bars i:last-child { width: 20px; }

  /* --- Panel móvil ------------------------------------------------------- */

  .drawer { position: fixed; inset: 0; z-index: var(--z-drawer); }
  .drawer[hidden] { display: none; }

  .drawer-scrim {
    position: absolute;
    inset: 0;
    background: rgba(3, 7, 16, 0.7);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 420ms var(--ease);
  }

  .drawer-panel {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(30rem, 100%);
    display: flex;
    flex-direction: column;
    background: linear-gradient(200deg, var(--navy-800) 0%, var(--navy-950) 65%);
    border-left: 1px solid var(--hair);
    transform: translateX(100%);
    transition: transform 520ms var(--ease);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .drawer.is-open .drawer-scrim { opacity: 1; }
  .drawer.is-open .drawer-panel { transform: none; }

  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem var(--gutter);
    border-bottom: 1px solid var(--hair-soft);
  }

  .drawer-close {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    color: var(--gold-300);
    border: 1px solid var(--hair);
    border-radius: var(--radius-sm);
    transition: background-color var(--dur) var(--ease);
  }

  .drawer-close:hover { background: rgba(201, 162, 39, 0.1); }

  .drawer-nav { flex: 1; padding: 1.5rem var(--gutter); }
  .drawer-nav ul { list-style: none; padding: 0; margin: 0; }

  .drawer-item {
    border-bottom: 1px solid var(--hair-soft);
    opacity: 0;
    transform: translateX(18px);
    transition: opacity 520ms var(--ease), transform 520ms var(--ease);
    transition-delay: calc(var(--i) * 55ms + 120ms);
  }

  .drawer.is-open .drawer-item { opacity: 1; transform: none; }

  .drawer-link,
  .drawer-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.05rem 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--fg);
    cursor: pointer;
    list-style: none;
  }

  .drawer-item summary::-webkit-details-marker { display: none; }
  .drawer-plus { color: var(--accent); transition: transform 380ms var(--ease); }
  .drawer-item details[open] .drawer-plus { transform: rotate(135deg); }

  .drawer-sub { padding-bottom: 1rem !important; }

  .drawer-sub a {
    display: block;
    padding: 0.55rem 0 0.55rem 1.1rem;
    border-left: 1px solid var(--hair);
    font-size: var(--step--1);
    color: var(--fg-muted);
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .drawer-sub a:hover { color: var(--gold-300); border-color: var(--gold-500); }

  .drawer-foot {
    padding: 1.5rem var(--gutter) 2.5rem;
    border-top: 1px solid var(--hair-soft);
    display: grid;
    gap: 1.2rem;
  }

  .drawer-contact { display: grid; gap: 0.65rem; }

  .drawer-contact a {
    display: flex;
    align-items: center;
    gap: 0.7em;
    font-size: var(--step--1);
    color: var(--fg-muted);
    word-break: break-word;
  }

  .drawer-contact a:hover { color: var(--gold-300); }

  .drawer-values {
    font-size: var(--step--2);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--fg-dim);
  }

  /* --- Puntos de quiebre ------------------------------------------------- */

  /* Por debajo de esto no cabe logo + CTA + hamburguesa sin apretarlo todo.
     El panel móvil ya abre con el mismo CTA en dorado y a ancho completo. */
  @media (max-width: 760px) {
    .header-cta { display: none; }
  }

  @media (min-width: 1080px) {
    .header-nav { display: block; }
    .burger { display: none; }
    .header-cta { --btn-px: 1.5em; }
  }

  /* El teléfono sólo aparece cuando sobra sitio de verdad */
  @media (min-width: 1560px) {
    .header-phone { display: inline-flex; }
  }
</style>

<script>
  /* Panel móvil: apertura, cierre, bloqueo de scroll y trampa de foco. */
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const header = document.querySelector<HTMLElement>('[data-header]');

  if (drawer && burger) {
    let lastFocused: HTMLElement | null = null;

    const open = () => {
      lastFocused = document.activeElement as HTMLElement;
      drawer.hidden = false;
      requestAnimationFrame(() => drawer.classList.add('is-open'));
      burger.setAttribute('aria-expanded', 'true');
      header?.classList.add('is-open');
      document.body.classList.add('is-locked');
      drawer.querySelector<HTMLElement>('.drawer-close')?.focus();
    };

    const close = () => {
      drawer.classList.remove('is-open');
      burger.setAttribute('aria-expanded', 'false');
      header?.classList.remove('is-open');
      document.body.classList.remove('is-locked');
      setTimeout(() => { drawer.hidden = true; }, 520);
      lastFocused?.focus();
    };

    burger.addEventListener('click', open);
    drawer.querySelectorAll('[data-drawer-close]').forEach((el) => el.addEventListener('click', close));
    drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) close();
      if (e.key !== 'Tab' || !drawer.classList.contains('is-open')) return;

      const focusables = drawer.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), summary, [tabindex]:not([tabindex="-1"])',
      );
      if (!focusables.length) return;

      const first = focusables[0];
      const last = focusables[focusables.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // Al pasar a escritorio el panel deja de tener sentido.
    matchMedia('(min-width: 1080px)').addEventListener('change', (e) => {
      if (e.matches && drawer.classList.contains('is-open')) close();
    });
  }
</script>
