---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import PostCard from './PostCard.astro';
import { academySection, cta } from '../data/site';

const posts = (await getCollection('posts'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .filter((p) => p.data.featured)
  .slice(0, 3);
---

<section class="section academy grain" id="academia">
  <div class="shell academy-inner">
    <header class="academy-head" data-reveal="left">
      <p class="sec-meta">
        <span class="sec-index">{academySection.index}</span>
        <span class="eyebrow eyebrow-plain">{academySection.eyebrow}</span>
      </p>

      <h2 class="title academy-title">{academySection.title}</h2>
      <p class="lead">{academySection.lead}</p>

      <a class="btn btn-gold academy-cta" href="/academia">
        {cta.explore}
        <Icon name="arrow" size={16} />
      </a>
    </header>

    <div class="academy-posts" data-reveal-group data-stagger="110">
      {posts.map((post) => (
        <div data-reveal-item data-reveal><PostCard post={post} /></div>
      ))}
    </div>
  </div>
</section>

<style>
  .academy {
    position: relative;
    background:
      radial-gradient(80% 60% at 100% 0%, rgba(201, 162, 39, 0.08), transparent 62%),
      linear-gradient(180deg, var(--navy-900), var(--navy-950));
    overflow: hidden;
  }

  .academy-inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  .academy-head { display: grid; gap: 1.2rem; align-content: start; }

  .sec-meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    line-height: 1;
  }

  .sec-index {
    font-family: var(--font-display);
    font-size: var(--step-0);
    letter-spacing: 0.08em;
    color: var(--gold-600);
    padding-right: 0.9rem;
    border-right: 1px solid var(--hair-strong);
  }

  .academy-title { font-size: var(--step-3); }

  .academy-cta { justify-self: start; margin-top: 0.6rem; }

  .academy-posts {
    display: grid;
    gap: clamp(1rem, 1.6vw, 1.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }

  .academy-posts > * { height: 100%; }

  @media (min-width: 1080px) {
    .academy-inner { grid-template-columns: minmax(16rem, 20rem) 1fr; gap: clamp(2.5rem, 4vw, 4rem); }
    .academy-head { position: sticky; top: calc(var(--header-h-scrolled) + 3rem); }
    .academy-posts { grid-template-columns: repeat(3, 1fr); }
  }
</style>
