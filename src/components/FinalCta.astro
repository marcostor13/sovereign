---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { finalCta, cta, contact } from '../data/site';
import backdrop from '../assets/img/familias.png';
---

<section class="cta-band grain" aria-labelledby="cta-title">
  <div class="cta-media" aria-hidden="true">
    <Image
      src={backdrop}
      alt=""
      widths={[900, 1440, 1920]}
      sizes="100vw"
      loading="lazy"
      quality={72}
      format="avif"
    />
  </div>

  <div class="cta-scrim" aria-hidden="true"></div>

  <div class="shell cta-inner">
    <p class="eyebrow" data-reveal="fade">{finalCta.eyebrow}</p>

    <h2 id="cta-title" class="display cta-title" data-reveal style="--reveal-delay:80ms">
      {finalCta.title}
    </h2>

    <p class="lead cta-lead" data-reveal style="--reveal-delay:160ms">{finalCta.lead}</p>

    <ul class="cta-points" data-reveal style="--reveal-delay:240ms">
      {finalCta.points.map((p) => (
        <li><Icon name="check" size={14} stroke={2} />{p}</li>
      ))}
    </ul>

    <div class="cta-actions" data-reveal style="--reveal-delay:320ms">
      <a class="btn btn-gold btn-lg" href="/contacto">
        <Icon name="calendar" size={17} />
        {cta.primary}
      </a>

      <a class="btn btn-outline btn-lg" href={contact.phoneHref}>
        <Icon name="phone" size={16} />
        {contact.phone}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    padding-block: clamp(4.5rem, 10vw, 9rem);
    overflow: hidden;
    isolation: isolate;
    background: var(--navy-990);
    text-align: center;
  }

  .cta-media { position: absolute; inset: 0; z-index: -2; }

  .cta-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .cta-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      /* Óvalo oscuro tras el bloque de texto: mantiene legible el titular
         sobre las zonas claras del cielo sin apagar toda la fotografía. */
      radial-gradient(58% 62% at 50% 46%, rgba(3, 7, 16, 0.72), transparent 78%),
      linear-gradient(180deg, rgba(3, 7, 16, 0.86) 0%, rgba(5, 12, 22, 0.6) 42%, rgba(3, 7, 16, 0.92) 100%),
      radial-gradient(60% 55% at 50% 55%, rgba(201, 162, 39, 0.16), transparent 72%);
  }

  .cta-inner {
    display: grid;
    justify-items: center;
    gap: clamp(1rem, 2vw, 1.5rem);
    max-width: 56rem;
  }

  .cta-title {
    font-size: var(--step-5);
    color: #fff;
    text-wrap: balance;
  }

  .cta-lead { color: #c2ccd9; }

  .cta-points {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem 1.8rem;
    padding: 1rem 0 0;
    margin: 0;
    list-style: none;
  }

  .cta-points li {
    display: flex;
    align-items: center;
    gap: 0.55em;
    font-size: var(--step--2);
    font-weight: 450;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--bone-200);
  }

  .cta-points :global(svg) { color: var(--gold-400); }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
    margin-top: clamp(0.8rem, 2vw, 1.4rem);
  }
</style>
