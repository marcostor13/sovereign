---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import LandingHeader from '../components/funnel/LandingHeader.astro';
import LandingFooter from '../components/funnel/LandingFooter.astro';
import { brand, contact, ui } from '../data/site';
import { agency, agent } from '../data/compliance';

interface Props {
  title: string;
  description: string;
  /** Se añade a <body> para variar el tratamiento de la cabecera por página. */
  bodyClass?: string;
  /** Cabecera transparente sobre un hero a sangre. */
  transparentHeader?: boolean;
  ogType?: 'website' | 'article';
  publishedAt?: Date;
  noIndex?: boolean;
  /** Ruta canónica alternativa (variantes A/B apuntan a la URL principal). */
  canonicalPath?: string;
  /** Título completo sin el sufijo de marca. */
  rawTitle?: boolean;
  /**
   * Página de embudo: cabecera mínima sin menú y pie legal completo, como
   * exigen las landings de anuncios.
   */
  landing?: { cta: { label: string; href: string }; disclosure: 'iul' | 'wholeLife' };
}

const {
  title,
  description,
  bodyClass = '',
  transparentHeader = false,
  ogType = 'website',
  publishedAt,
  noIndex = false,
  canonicalPath,
  rawTitle = false,
  landing,
} = Astro.props;

const siteName = `${brand.name} ${brand.surname}`;
const fullTitle = rawTitle ? title : title === siteName ? `${siteName} — ${brand.descriptor}` : `${title} · ${brand.name}`;
const canonical = new URL(canonicalPath || Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const sameAs = contact.socials.map((s) => s.href).filter(Boolean);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'InsuranceAgency',
  name: siteName,
  alternateName: brand.name,
  description: brand.descriptor,
  slogan: brand.signature,
  url: Astro.site?.href,
  telephone: contact.phone,
  email: contact.email,
  areaServed: { '@type': 'Country', name: 'United States' },
  knowsLanguage: ['es', 'en'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${agency.street}, ${agency.suite}`,
    addressLocality: agency.city,
    addressRegion: agency.region,
    postalCode: agency.postalCode,
    addressCountry: 'US',
  },
  founder: { '@type': 'Person', name: agent.name, jobTitle: agent.role },
  ...(sameAs.length ? { sameAs } : {}),
};
---

<!doctype html>
<html lang="es-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="canonical" href={canonical} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a1628" />
    <meta name="author" content={siteName} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_US" />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* El .ico lleva 16/32/48 con un encuadre propio por tamaño; el PNG es para
        los navegadores que prefieren `image/png`. */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500;600&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} is:inline />

    <Analytics />

    {/* Datos estructurados adicionales por página (artículos, FAQ…) */}
    <slot name="head" />
  </head>

  <body class:list={[bodyClass, landing && 'is-landing']}>
    <a class="skip-link" href="#main">{ui.skip}</a>
    <div class="scroll-progress" aria-hidden="true"><i></i></div>

    {landing ? <LandingHeader cta={landing.cta} /> : <Header transparent={transparentHeader} />}

    <main id="main">
      <slot />
    </main>

    {landing ? <LandingFooter disclosure={landing.disclosure} /> : <Footer />}

    <script>
      /* ---------------------------------------------------------------------
         Comportamiento global: revelado al hacer scroll, estado de la cabecera
         y barra de progreso de lectura. Todo con IntersectionObserver y rAF
         para no bloquear el hilo principal.
         --------------------------------------------------------------------- */

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* --- Revelado progresivo ------------------------------------------- */
      const revealTargets = document.querySelectorAll<HTMLElement>('[data-reveal], [data-reveal-group]');

      if (reduceMotion) {
        revealTargets.forEach((el) => el.classList.add('is-in'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              el.classList.add('is-in');

              // Un grupo escalona a sus hijos directos marcados.
              if (el.hasAttribute('data-reveal-group')) {
                const step = Number(el.dataset.stagger || 90);
                el.querySelectorAll<HTMLElement>('[data-reveal-item]').forEach((child, i) => {
                  child.style.setProperty('--reveal-delay', `${i * step}ms`);
                  child.classList.add('is-in');
                });
              }
              observer.unobserve(el);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
        );
        revealTargets.forEach((el) => observer.observe(el));
      }

      /* --- Cabecera: compacta al hacer scroll ----------------------------- */
      const header = document.querySelector<HTMLElement>('[data-header]');
      const progress = document.querySelector<HTMLElement>('.scroll-progress i');
      let lastY = window.scrollY;
      let ticking = false;

      const onScroll = () => {
        const y = window.scrollY;

        if (header) {
          header.classList.toggle('is-scrolled', y > 40);
          // Se oculta al bajar y reaparece al subir, sólo pasada la primera pantalla.
          header.classList.toggle('is-hidden', y > 420 && y > lastY && !header.classList.contains('is-open'));
        }

        if (progress) {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          progress.style.transform = `scaleX(${max > 0 ? Math.min(y / max, 1) : 0})`;
        }

        lastY = y;
        ticking = false;
      };

      window.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(onScroll);
        },
        { passive: true },
      );

      onScroll();
    </script>

    <style is:global>
      .scroll-progress {
        position: fixed;
        inset: 0 0 auto 0;
        height: 2px;
        z-index: calc(var(--z-header) + 5);
        pointer-events: none;
      }

      .scroll-progress i {
        display: block;
        height: 100%;
        background: linear-gradient(90deg, var(--gold-700), var(--gold-300), var(--gold-500));
        transform: scaleX(0);
        transform-origin: left;
      }
    </style>
  </body>
</html>
