---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { contactPage, contact, finalCta } from '../data/site';
---

<Base
  title="Contacto"
  description="Agenda tu consulta estratégica privada con Sovereign Capital Solutions. 45 minutos, sin costo y sin compromiso, con un asesor senior."
>
  <PageHero
    eyebrow={contactPage.eyebrow}
    title={contactPage.title}
    lead={contactPage.lead}
    crumbs={[{ label: 'Contacto' }]}
    meta={[...finalCta.points]}
    size="lg"
  />

  <section class="section">
    <div class="shell contact">
      <div class="contact-form" data-reveal>
        <ContactForm />
      </div>

      <aside class="contact-side">
        {/* --- Qué ocurre después ---------------------------------------- */}
        <div class="side-card" data-reveal="right">
          <h2 class="side-title">{contactPage.expect.title}</h2>

          <ol class="expect">
            {contactPage.expect.steps.map((s) => (
              <li>
                <span class="expect-n">{s.n}</span>
                <span>{s.text}</span>
              </li>
            ))}
          </ol>
        </div>

        {/* --- Datos de contacto ----------------------------------------- */}
        <div class="side-card" data-reveal="right" style="--reveal-delay:100ms">
          <h2 class="side-title">{contactPage.infoTitle}</h2>

          <ul class="info">
            <li>
              <Icon name="phone" size={17} />
              <span>
                <b>Teléfono</b>
                <a href={contact.phoneHref}>{contact.phone}</a>
              </span>
            </li>
            <li>
              <Icon name="mail" size={17} />
              <span>
                <b>Correo</b>
                <a href={`mailto:${contact.email}`}>{contact.email}</a>
              </span>
            </li>
            <li>
              <Icon name="pin" size={17} />
              <span>
                <b>Oficina</b>
                {contact.address}
              </span>
            </li>
            <li>
              <Icon name="clock" size={17} />
              <span>
                <b>Horario</b>
                {contact.hours}
              </span>
            </li>
          </ul>

          <ul class="side-social">
            {contact.socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
                  <Icon name={s.id} size={16} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  .contact-form {
    padding: clamp(1.5rem, 3.2vw, 2.6rem);
    border: 1px solid var(--hair);
    border-radius: var(--radius);
    background: linear-gradient(170deg, rgba(255, 255, 255, 0.035), transparent 60%);
  }

  .contact-side { display: grid; gap: 1rem; }

  .side-card {
    padding: clamp(1.4rem, 2.8vw, 2rem);
    border: 1px solid var(--hair-soft);
    border-radius: var(--radius);
    background: linear-gradient(165deg, var(--navy-800), var(--navy-950));
  }

  .side-title {
    padding-bottom: 0.85rem;
    margin-bottom: 1.2rem;
    border-bottom: 1px solid var(--hair-soft);
    font-family: var(--font-sans);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent);
  }

  /* --- Qué ocurre después -------------------------------------------------- */

  .expect { display: grid; gap: 1.1rem; list-style: none; padding: 0; margin: 0; }

  .expect li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--fg-muted);
  }

  .expect-n {
    font-family: var(--font-display);
    font-size: var(--step-0);
    letter-spacing: 0.08em;
    color: var(--gold-600);
  }

  /* --- Información --------------------------------------------------------- */

  .info { display: grid; gap: 1.1rem; list-style: none; padding: 0; margin: 0; }

  .info li { display: grid; grid-template-columns: auto 1fr; gap: 0.9rem; align-items: start; }
  .info :global(svg) { margin-top: 0.25em; color: var(--gold-500); }

  .info span { display: grid; gap: 0.2rem; font-size: var(--step--1); color: var(--fg-muted); }

  .info b {
    font-size: var(--step--2);
    font-weight: 450;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--fg-dim);
  }

  .info a { word-break: break-word; transition: color var(--dur) var(--ease); }
  .info a:hover { color: var(--gold-300); }

  .side-social {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 1.3rem 0 0;
    margin: 1.3rem 0 0;
    border-top: 1px solid var(--hair-soft);
  }

  .side-social a {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    color: var(--gold-300);
    border: 1px solid var(--hair);
    border-radius: 50%;
    transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease),
                border-color var(--dur) var(--ease);
  }

  .side-social a:hover {
    background: var(--gold-500);
    border-color: var(--gold-500);
    color: var(--navy-950);
  }

  @media (min-width: 1000px) {
    .contact { grid-template-columns: minmax(0, 1fr) minmax(19rem, 24rem); gap: clamp(2.5rem, 4vw, 4rem); }
    .contact-side { position: sticky; top: calc(var(--header-h-scrolled) + 2rem); }
  }
</style>
