---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Calculator from '../../components/Calculator.astro';
import GuideModal from '../../components/funnel/GuideModal.astro';
import StickyCta from '../../components/funnel/StickyCta.astro';
import { masterclass, wlMasterclassPage as m } from '../../data/banca-mia';

/**
 * Masterclass evergreen. Acceso con el token del registro (URL o este
 * dispositivo). El progreso del video se reporta al servidor (25/50/75/95) y
 * la invitación al diagnóstico aparece a partir del minuto 20.
 */
const videoId = import.meta.env.PUBLIC_MASTERCLASS_VIMEO_ID;
const mmss = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
---

<Base
  title={`Masterclass Banca Mía™ · ${masterclass.name}`}
  description="Masterclass gratuita sobre estrategias con seguro de vida Whole Life para empresarios."
  noIndex
  landing={{ cta: { label: 'Aplicar al diagnóstico', href: '/banca-mia/diagnostico' }, disclosure: 'wholeLife' }}
>
  <div class="lp mc" data-masterclass data-video-id={videoId} data-cta-at={masterclass.ctaAt}>
    <section class="lp-section lp-deep mc-top">
      <div class="lp-shell">
        <div class="mc-gate" data-gate hidden>
          <h1 class="lp-h2">{m.noAccess}</h1>
          <a class="btn btn-gold btn-lg" href="/banca-mia#registro">{m.noAccessCta}<Icon name="arrow" size={17} /></a>
        </div>

        <div data-content>
          <header class="mc-head">
            <p class="lp-eyebrow">Masterclass · {masterclass.minutes} min · Estrategia con seguro de vida Whole Life</p>
            <h1 class="lp-h2 mc-title" data-welcome data-template={m.welcome}>{m.welcomeAnon}</h1>
            <p class="lp-lead">{masterclass.name}</p>
          </header>

          <div class="mc-grid">
            <div class="mc-player">
              {videoId ? (
                <div class="mc-frame">
                  <iframe
                    data-player
                    src={`https://player.vimeo.com/video/${videoId}?texttrack=es&dnt=1&title=0&byline=0&portrait=0`}
                    allow="autoplay; fullscreen; picture-in-picture"
                    title={masterclass.name}
                  ></iframe>
                </div>
              ) : (
                <div class="mc-frame mc-pending">
                  <Icon name="play" size={56} stroke={1} />
                  <p>{m.pending}</p>
                </div>
              )}
              <p class="lp-legal">{m.legal}</p>
            </div>

            <aside class="mc-chapters">
              <h2>{m.chaptersTitle}</h2>
              <ol>
                {masterclass.chapters.map((c) => (
                  <li>
                    <button type="button" data-seek={c.at} disabled={!videoId}>
                      <span>{mmss(c.at)}</span>
                      {c.label}
                    </button>
                  </li>
                ))}
              </ol>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <section class="lp-section lp-light">
      <div class="lp-shell mc-extras">
        <div class="lp-card">
          <h2 class="mc-h">{m.downloadsTitle}</h2>
          {m.downloads.map((d) => (
            <div class="mc-dl">
              <Icon name="doc" size={24} />
              <div>
                <p class="mc-dl-title">{d.title}</p>
                <p>{d.text}</p>
              </div>
              <button class="btn btn-outline" type="button" data-guide-open={d.key}>
                <Icon name="download" size={15} />
                Descargar
              </button>
            </div>
          ))}

          <h2 class="mc-h mc-h-space">{m.checklistTitle}</h2>
          <ol class="mc-check">
            {m.checklist.map((c) => <li>{c}</li>)}
          </ol>
        </div>

        <div class="mc-side">
          <div class="lp-card">
            <h2 class="mc-h">{m.qaTitle}</h2>
            <p>{m.qaText}</p>
            <a class="btn btn-outline" href="/contacto">
              <Icon name="calendar" size={15} />
              {m.qaCta}
            </a>
          </div>
          <div class="lp-card mc-apply">
            <h2 class="mc-h">{m.stickyText}</h2>
            <a class="btn btn-gold" href="/banca-mia/diagnostico">
              {m.stickyCta}
              <Icon name="arrow" size={16} />
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="lp-section lp-dark">
      <div class="lp-shell" data-calc-wrap>
        <Calculator />
      </div>
    </section>
  </div>

  <StickyCta label={m.stickyCta} href="/banca-mia/diagnostico" text={m.stickyText} always deferred id="mc-sticky" />
  <GuideModal />
</Base>

{videoId && <script is:inline src="https://player.vimeo.com/api/player.js"></script>}

<script>
  import { track, readCookie } from '../../lib/client/track';
  import { WL_TOKEN_KEY, savedContact } from '../../lib/client/storage';

  const root = document.querySelector<HTMLElement>('[data-masterclass]')!;
  const sticky = document.getElementById('mc-sticky');
  const params = new URLSearchParams(location.search);

  const ls = {
    get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } },
    set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* sin persistencia */ } },
  };

  // Token: el de la URL tiene prioridad y se recuerda en este dispositivo.
  const urlToken = params.get('t');
  if (urlToken) ls.set(WL_TOKEN_KEY, urlToken);
  const token = urlToken || ls.get(WL_TOKEN_KEY);

  const leadId = (() => {
    try {
      return JSON.parse(atob((token || '').split('.')[0].replace(/-/g, '+').replace(/_/g, '/'))).l as string;
    } catch {
      return '';
    }
  })();

  if (!token || !leadId) {
    root.querySelector<HTMLElement>('[data-gate]')!.hidden = false;
    root.querySelector<HTMLElement>('[data-content]')!.hidden = true;
  } else {
    const name = savedContact()?.nombre?.split(/\s+/)[0];
    const welcome = root.querySelector<HTMLElement>('[data-welcome]')!;
    if (name) welcome.textContent = (welcome.dataset.template || '').replace('{nombre}', name);
  }

  const showSticky = () => sticky?.classList.add('is-on');

  // Arrastra el token al diagnóstico para continuar el mismo lead.
  if (token) {
    document.querySelectorAll<HTMLAnchorElement>('a[href="/banca-mia/diagnostico"]').forEach((a) => {
      a.href = `/banca-mia/diagnostico?t=${encodeURIComponent(token)}`;
    });
  }

  const videoId = root.dataset.videoId;
  const ctaAt = Number(root.dataset.ctaAt || 1200);

  if (!videoId) {
    showSticky();
  } else if (token && leadId) {
    type VimeoPlayer = {
      on: (e: string, cb: (d: { seconds: number; percent: number }) => void) => void;
      setCurrentTime: (s: number) => Promise<number>;
      play: () => Promise<void>;
    };
    const Vimeo = (window as unknown as { Vimeo?: { Player: new (el: Element) => VimeoPlayer } }).Vimeo;
    const iframe = root.querySelector('[data-player]');

    if (Vimeo && iframe) {
      const player = new Vimeo.Player(iframe);
      const progressKey = `sov_mc_pos_${leadId}`;
      const sentKey = `sov_mc_sent_${leadId}`;
      const sent = new Set((ls.get(sentKey) || '').split(',').filter(Boolean));

      // Retoma donde lo dejó.
      const resume = Number(ls.get(progressKey) || 0);
      if (resume > 30) player.setCurrentTime(resume).catch(() => {});
      if (resume >= ctaAt) showSticky();

      player.on('play', () => {
        if (!sent.has('play')) {
          sent.add('play');
          ls.set(sentKey, [...sent].join(','));
          track('VideoPlay', { content_name: 'masterclass_banca_mia' });
        }
      });

      let lastSave = 0;
      player.on('timeupdate', ({ seconds, percent }) => {
        if (seconds - lastSave > 10 || seconds < lastSave) {
          lastSave = seconds;
          ls.set(progressKey, String(Math.floor(seconds)));
        }
        if (seconds >= ctaAt) showSticky();

        for (const milestone of [25, 50, 75, 95]) {
          if (percent * 100 < milestone || sent.has(String(milestone))) continue;
          sent.add(String(milestone));
          ls.set(sentKey, [...sent].join(','));

          if (milestone === 50 || milestone === 95) {
            track(`VioMasterclass${milestone}`, { percent: milestone }, `${leadId}-video${milestone}`);
          } else {
            track(`Video${milestone}`, { percent: milestone });
          }

          fetch('/api/leads/banca-mia/video-progress', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ token, percent: milestone, pageUrl: location.href, fbp: readCookie('_fbp'), fbc: readCookie('_fbc') }),
            keepalive: true,
          }).catch(() => {});
        }
      });

      root.querySelectorAll<HTMLButtonElement>('[data-seek]').forEach((btn) =>
        btn.addEventListener('click', () => {
          player.setCurrentTime(Number(btn.dataset.seek)).then(() => player.play()).catch(() => {});
          root.querySelector('.mc-frame')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }),
      );
    }
  }

  // Uso de la calculadora (una vez).
  const calc = document.querySelector('[data-calc-wrap]');
  calc?.addEventListener('input', () => track('UsoCalculadora'), { once: true });
</script>

<style>
  .mc-top { padding-block: clamp(2rem, 5vw, 4rem); }

  .mc-gate { display: grid; gap: 1.4rem; justify-items: start; padding-block: 3rem; }
  .mc-gate[hidden], [data-content][hidden] { display: none; }

  .mc-head { display: grid; gap: 0.6rem; margin-bottom: 1.6rem; }
  .mc-title { color: #fff; font-size: var(--step-3); }

  .mc-grid { display: grid; gap: 1.4rem; }

  .mc-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    overflow: hidden;
    background: #000;
    border: 1px solid var(--hair);
  }

  .mc-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  .mc-pending {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1rem;
    padding: 1.5rem;
    text-align: center;
    background: linear-gradient(160deg, var(--navy-800), var(--navy-990));
    color: var(--gold-400);
  }

  .mc-pending p { max-width: 32rem; color: var(--fg-muted); }

  .mc-chapters { padding: 1.2rem; border: 1px solid var(--hair); border-radius: 14px; align-self: start; }
  .mc-chapters h2 { font-family: var(--font-sans); font-size: var(--step--2); letter-spacing: var(--tracking-wider); text-transform: uppercase; color: var(--gold-400); margin-bottom: 0.6rem; }
  .mc-chapters ol { display: grid; gap: 0.2rem; list-style: none; padding: 0; margin: 0; }

  .mc-chapters button {
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    gap: 0.5rem;
    width: 100%;
    min-height: 44px;
    padding: 0.5rem;
    text-align: left;
    font-size: var(--step--1);
    line-height: 1.4;
    color: var(--bone-200);
    border-radius: 8px;
  }

  .mc-chapters button:not([disabled]):hover { background: rgba(201, 162, 39, 0.1); }
  .mc-chapters button[disabled] { cursor: default; }
  .mc-chapters button span { color: var(--gold-400); font-variant-numeric: tabular-nums; }

  .mc-extras { display: grid; gap: 1rem; }
  .mc-side { display: grid; gap: 1rem; align-content: start; }

  .mc-h { font-size: var(--step-2); color: var(--ink-900); }
  .mc-h-space { margin-top: 1.6rem; }

  .mc-dl { display: grid; grid-template-columns: auto 1fr; gap: 0.8rem; align-items: start; margin-top: 0.8rem; }
  .mc-dl > :global(svg) { color: var(--gold-700); }
  .mc-dl .btn { grid-column: 1 / -1; justify-self: start; color: var(--ink-900); }
  .mc-dl-title { color: var(--ink-900) !important; font-weight: 500; }

  .mc-check { display: grid; gap: 0.6rem; padding-left: 1.3rem; margin: 0.6rem 0 0; color: var(--ink-700); }
  .mc-check li { line-height: 1.55; }

  .mc-side .btn { justify-self: start; margin-top: 0.4rem; }
  .mc-side .btn-outline { color: var(--ink-900); }

  .mc-apply { background: var(--navy-850) !important; }
  .mc-apply .mc-h { color: #fff; }

  @media (min-width: 1000px) {
    .mc-grid { grid-template-columns: minmax(0, 1fr) 20rem; }
    .mc-extras { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); }
  }
</style>
