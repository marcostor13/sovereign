---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import Icon from '../../components/Icon.astro';
import FinalCta from '../../components/FinalCta.astro';
import { ui, academySection, brand } from '../../data/site';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );

  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      // Relacionados: primero la misma categoría, luego los más recientes.
      related: posts
        .filter((p) => p.id !== entry.id)
        .sort((a, b) => {
          const sameA = a.data.category === entry.data.category ? 0 : 1;
          const sameB = b.data.category === entry.data.category ? 0 : 1;
          return sameA - sameB || b.data.date.getTime() - a.data.date.getTime();
        })
        .slice(0, 3),
    },
  }));
}

const { entry, related } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

const formatted = d.date.toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.excerpt,
  datePublished: d.date.toISOString(),
  articleSection: d.category,
  author: { '@type': 'Organization', name: `${brand.name} ${brand.surname}` },
  publisher: { '@type': 'Organization', name: `${brand.name} ${brand.surname}` },
};

const sections = headings.filter((h) => h.depth === 2);
---

<Base title={d.title} description={d.excerpt} ogType="article" publishedAt={d.date}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} is:inline slot="head" />

  <PageHero
    eyebrow={d.category}
    title={d.title}
    lead={d.excerpt}
    crumbs={[{ label: 'Academia', href: '/academia' }, { label: d.title }]}
    meta={[`${ui.publishedOn} ${formatted}`, `${d.read} ${academySection.minRead} de lectura`]}
  />

  <section class="section">
    <div class="shell article">
      {sections.length > 1 && (
        <aside class="toc" data-reveal="left">
          <p class="toc-title">{ui.index}</p>
          <nav aria-label="Índice del artículo">
            <ol>
              {sections.map((h) => (
                <li><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ol>
          </nav>
        </aside>
      )}

      <div class="article-body prose prose-lead" data-reveal>
        <Content />
      </div>
    </div>

    <div class="shell article-foot">
      <a class="link-arrow back" href="/academia">
        <Icon name="arrow" size={15} />
        {ui.backToAcademy}
      </a>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section section-deep">
      <div class="shell">
        <h2 class="title related-title" data-reveal>{ui.related}</h2>

        <ul class="related" data-reveal-group data-stagger="90">
          {related.map((post) => (
            <li data-reveal-item data-reveal><PostCard post={post} /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <FinalCta />
</Base>

<style>
  .article {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .article-body { min-width: 0; max-width: 44rem; }

  /* --- Índice lateral ----------------------------------------------------- */

  .toc {
    padding: clamp(1.2rem, 2.4vw, 1.7rem);
    border: 1px solid var(--hair-soft);
    border-radius: var(--radius);
    background: linear-gradient(165deg, rgba(255, 255, 255, 0.04), transparent);
  }

  .toc-title {
    padding-bottom: 0.75rem;
    margin-bottom: 0.9rem;
    border-bottom: 1px solid var(--hair-soft);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent);
  }

  .toc ol {
    display: grid;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: toc;
  }

  .toc li { counter-increment: toc; }

  .toc a {
    display: grid;
    grid-template-columns: 1.6em 1fr;
    gap: 0.3rem;
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--fg-muted);
    transition: color var(--dur) var(--ease);
  }

  .toc a::before {
    content: counter(toc, decimal-leading-zero);
    font-family: var(--font-display);
    color: var(--gold-700);
  }

  .toc a:hover { color: var(--gold-300); }
  .toc a:hover::before { color: var(--gold-400); }

  .article-foot { margin-top: clamp(2.5rem, 5vw, 4rem); }
  .back :global(svg) { transform: rotate(180deg); }
  .back:hover :global(svg) { transform: rotate(180deg) translateX(5px); }

  /* --- Relacionados ------------------------------------------------------- */

  .related-title { font-size: var(--step-3); margin-bottom: clamp(1.5rem, 3vw, 2.2rem); }

  .related {
    display: grid;
    gap: clamp(1rem, 1.8vw, 1.6rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .related > li { height: 100%; }

  @media (min-width: 1000px) {
    .article { grid-template-columns: minmax(14rem, 17rem) minmax(0, 1fr); gap: clamp(3rem, 5vw, 5rem); }
    .toc { position: sticky; top: calc(var(--header-h-scrolled) + 2rem); }
    .article-foot { padding-left: calc(17rem + 5rem); }
  }
</style>
