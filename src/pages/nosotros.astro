---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Method from '../components/Method.astro';
import Stats from '../components/Stats.astro';
import FinalCta from '../components/FinalCta.astro';
import Icon from '../components/Icon.astro';
import { about, brand, founder, values } from '../data/site';

/**
 * Retrato del fundador. Se resuelve con `import.meta.glob` para que el sitio
 * compile con o sin la fotografía: basta con dejar el archivo en
 * `src/assets/img/founder.{jpg,jpeg,png,webp}` para que aparezca.
 */
const founderPhotos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/img/founder.{jpg,jpeg,png,webp}',
  { eager: true },
);
const founderPhoto = Object.values(founderPhotos)[0]?.default;
---

<Base
  title="Sobre Nosotros"
  description="Sovereign Capital Solutions es una firma de estrategia patrimonial fundada por Oswald Gonzalez. No vendemos productos: diseñamos arquitectura patrimonial con acompañamiento continuo."
>
  <PageHero
    eyebrow={about.eyebrow}
    title={about.title}
    lead={about.lead}
    crumbs={[{ label: 'Sobre Nosotros' }]}
    meta={[...values]}
  />

  {/* --- Relato + retrato ------------------------------------------------ */}
  <section class="section section-light on-light">
    <div class="shell story">
      <div class="story-media" data-reveal="left">
        <figure class="story-quote">
          <p class="story-signature">{brand.signature}</p>
          <blockquote>{brand.promise}</blockquote>
          <figcaption>{brand.name} {brand.surname}</figcaption>
        </figure>
        <i class="story-frame" aria-hidden="true"></i>
      </div>

      <div class="story-copy" data-reveal="right">
        {about.body.map((p) => <p>{p}</p>)}

        <a class="btn btn-outline story-cta" href="/contacto">
          Conversemos sobre tu caso
          <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </section>

  {/* --- Principios ------------------------------------------------------ */}
  <section class="section">
    <div class="shell">
      <SectionHead
        eyebrow="Principios"
        title={about.pillarsTitle}
        lead={about.pillarsLead}
        align="center"
        size="lg"
      />

      <ul class="pillars" data-reveal-group data-stagger="90">
        {about.pillars.map((p, i) => (
          <li class="pillar-card card" data-reveal-item data-reveal>
            <span class="pillar-n">{String(i + 1).padStart(2, '0')}</span>
            <Icon name={p.icon} size={28} stroke={1.1} />
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* --- Comparativa ------------------------------------------------------ */}
  <section class="section section-light on-light">
    <div class="shell">
      <SectionHead
        eyebrow="Comparativa"
        title={about.differenceTitle}
        lead={about.differenceLead}
        align="center"
        size="lg"
      />

      <div class="compare" data-reveal>
        <div class="compare-head">
          <span class="compare-h is-old">{about.differenceHeads[0]}</span>
          <span class="compare-h is-new">{about.differenceHeads[1]}</span>
        </div>

        <ul>
          {about.difference.map((row) => (
            <li class="compare-row">
              <span class="compare-cell is-old">
                <Icon name="minus" size={15} stroke={2} />
                {row.a}
              </span>
              <span class="compare-cell is-new">
                <Icon name="check" size={15} stroke={2} />
                {row.b}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* --- El fundador ------------------------------------------------------ */}
  <section class="section founder-section" id="fundador">
    <div class="shell founder">
      <div class="founder-media" data-reveal="left">
        <div class="founder-portrait">
        {founderPhoto ? (
          <Image
            src={founderPhoto}
            alt={founder.photoAlt}
            widths={[520, 780, 1040]}
            sizes="(min-width: 1000px) 38vw, 92vw"
            loading="lazy"
            quality={80}
            format="avif"
          />
        ) : (
          <div class="founder-plate" role="img" aria-label={founder.photoAlt}>
            <span class="founder-monogram">SC</span>
            <span class="founder-plate-name">{founder.name}</span>
          </div>
        )}
          <i class="founder-frame" aria-hidden="true"></i>
        </div>

        <div class="founder-id">
          <p class="founder-name">{founder.name}</p>
          <p class="founder-role">{founder.role}</p>
          <p class="founder-credentials">{founder.credentials}</p>
        </div>
      </div>

      <div class="founder-copy" data-reveal="right">
        <p class="eyebrow">{founder.eyebrow}</p>
        <h2 class="title founder-tagline">{founder.tagline}</h2>
        <p class="founder-intro">{founder.intro}</p>

        <ul class="founder-blocks">
          {founder.blocks.map((b) => (
            <li>
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </li>
          ))}
        </ul>

        <ul class="founder-questions">
          {founder.questions.map((q) => (
            <li><Icon name="arrow" size={14} stroke={1.6} />{q}</li>
          ))}
        </ul>

        <p class="founder-closing">{founder.closing}</p>

        <figure class="founder-quote">
          <Icon name="quote" size={26} stroke={1.1} />
          <blockquote>{founder.quote}</blockquote>
          <figcaption>{founder.name} · {founder.role}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <Method />
  <Stats />
  <FinalCta />
</Base>

<style>
  /* --- Relato ------------------------------------------------------------ */

  .story {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  .story-media { position: relative; align-self: start; }

  .story-frame {
    position: absolute;
    inset: clamp(0.9rem, 2vw, 1.4rem) calc(clamp(0.9rem, 2vw, 1.4rem) * -1)
           calc(clamp(0.9rem, 2vw, 1.4rem) * -1) clamp(0.9rem, 2vw, 1.4rem);
    border: 1px solid var(--gold-500);
    opacity: 0.45;
    z-index: -1;
    border-radius: var(--radius);
  }

  .story-quote {
    position: relative;
    padding: clamp(1.8rem, 3.2vw, 2.6rem);
    background: linear-gradient(160deg, var(--navy-800), var(--navy-950));
    border: 1px solid var(--hair-strong);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }

  .story-quote blockquote {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.35;
    color: var(--bone-100);
  }

  .story-signature {
    margin-bottom: 1rem;
    font-size: var(--step--2);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--gold-500);
  }

  .story-quote figcaption {
    margin-top: 0.8rem;
    font-size: var(--step--2);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--gold-500);
  }

  .story-copy { display: grid; gap: 1.4rem; align-content: start; }

  .story-copy p {
    font-size: var(--step-1);
    line-height: 1.75;
    color: var(--ink-500);
    font-weight: 340;
  }

  .story-copy p:first-child { color: var(--ink-700); }

  .story-cta { justify-self: start; margin-top: 0.8rem; }

  @media (min-width: 1000px) {
    .story { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(3rem, 6vw, 6rem); }
  }

  /* --- Principios -------------------------------------------------------- */

  .pillars {
    display: grid;
    gap: clamp(1rem, 1.6vw, 1.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .pillar-card { gap: 0.9rem; }
  .pillar-card :global(svg) { color: var(--gold-400); }

  .pillar-n {
    font-family: var(--font-display);
    font-size: var(--step-0);
    letter-spacing: 0.1em;
    color: var(--gold-700);
  }

  .pillar-card h3 { font-size: var(--step-2); color: var(--fg); }

  .pillar-card p {
    font-size: var(--step--1);
    line-height: 1.65;
    color: var(--fg-muted);
  }

  /* --- El fundador -------------------------------------------------------- */

  .founder-section { position: relative; }

  .founder {
    display: grid;
    gap: clamp(2.8rem, 5vw, 4.5rem);
    align-items: start;
  }

  .founder-media { align-self: start; }

  .founder-portrait { position: relative; }

  .founder-media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: var(--radius);
  }

  .founder-frame {
    position: absolute;
    inset: clamp(0.9rem, 2vw, 1.4rem) calc(clamp(0.9rem, 2vw, 1.4rem) * -1)
           calc(clamp(0.9rem, 2vw, 1.4rem) * -1) clamp(0.9rem, 2vw, 1.4rem);
    border: 1px solid var(--gold-500);
    opacity: 0.4;
    z-index: -1;
    border-radius: var(--radius);
  }

  /* Lámina de marca mientras no exista la fotografía institucional. */
  .founder-plate {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1rem;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--hair-strong);
    border-radius: var(--radius);
    background: linear-gradient(160deg, var(--navy-800), var(--navy-990));
  }

  .founder-monogram {
    font-family: var(--font-roman);
    font-size: clamp(3rem, 7vw, 4.5rem);
    letter-spacing: 0.08em;
    color: var(--gold-500);
  }

  .founder-plate-name {
    font-size: var(--step--2);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--fg-dim);
  }

  .founder-id {
    position: relative;
    margin-top: clamp(1.2rem, 2.4vw, 1.8rem);
    padding-left: 1.1rem;
    border-left: 2px solid var(--gold-500);
  }

  .founder-name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.2;
    color: var(--fg);
  }

  .founder-role {
    margin-top: 0.25rem;
    font-size: var(--step--2);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--gold-500);
  }

  .founder-credentials {
    margin-top: 0.6rem;
    font-size: var(--step--2);
    line-height: 1.6;
    color: var(--fg-dim);
  }

  .founder-copy { display: grid; gap: 1.2rem; align-content: start; }

  .founder-tagline { font-size: var(--step-3); line-height: 1.2; }

  .founder-intro {
    font-size: var(--step-1);
    line-height: 1.7;
    color: var(--fg-muted);
    font-weight: 340;
  }

  .founder-blocks {
    display: grid;
    gap: clamp(1.2rem, 2.2vw, 1.8rem);
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .founder-blocks li {
    padding-left: 1.2rem;
    border-left: 1px solid var(--hair-strong);
  }

  .founder-blocks h3 {
    font-size: var(--step-0);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--fg);
  }

  .founder-blocks p {
    margin-top: 0.45rem;
    font-size: var(--step--1);
    line-height: 1.7;
    color: var(--fg-muted);
  }

  .founder-questions {
    display: grid;
    gap: 0.55rem;
    margin: 0.4rem 0 0;
    padding: clamp(1.1rem, 2.2vw, 1.5rem);
    list-style: none;
    border: 1px solid var(--hair-soft);
    border-radius: var(--radius);
    background: linear-gradient(100deg, rgba(201, 162, 39, 0.08), transparent 70%);
  }

  .founder-questions li {
    display: flex;
    align-items: center;
    gap: 0.65em;
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--bone-100);
  }

  .founder-questions :global(svg) { color: var(--gold-500); flex: none; }

  .founder-closing {
    font-size: var(--step--1);
    line-height: 1.7;
    color: var(--fg-muted);
  }

  .founder-quote {
    display: grid;
    gap: 0.9rem;
    margin: 0.6rem 0 0;
    padding: clamp(1.4rem, 2.6vw, 2rem);
    border: 1px solid var(--hair-strong);
    border-radius: var(--radius);
    background: linear-gradient(160deg, var(--navy-800), var(--navy-950));
    box-shadow: var(--shadow-lg);
  }

  .founder-quote :global(svg) { color: var(--gold-500); }

  .founder-quote blockquote {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--bone-100);
  }

  .founder-quote figcaption {
    font-size: var(--step--2);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--gold-500);
  }

  @media (min-width: 1000px) {
    .founder {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3rem, 6vw, 5.5rem);
    }

    .founder-media { position: sticky; top: calc(var(--header-h) + 2rem); }
  }

  /* --- Comparativa ------------------------------------------------------- */

  .compare {
    border: 1px solid rgba(10, 22, 40, 0.1);
    border-radius: var(--radius);
    background: #fff;
    overflow: hidden;
    box-shadow: 0 30px 70px -50px rgba(10, 22, 40, 0.45);
  }

  .compare ul { list-style: none; padding: 0; margin: 0; }

  .compare-head,
  .compare-row {
    display: grid;
    grid-template-columns: 1fr;
  }

  .compare-head { border-bottom: 1px solid rgba(10, 22, 40, 0.1); }

  .compare-h {
    padding: 1.1rem clamp(1.1rem, 2.4vw, 1.9rem);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .compare-h.is-old { color: #8b93a0; }

  .compare-h.is-new {
    color: var(--gold-700);
    background: linear-gradient(100deg, rgba(201, 162, 39, 0.12), rgba(201, 162, 39, 0.04));
  }

  .compare-row + .compare-row { border-top: 1px solid rgba(10, 22, 40, 0.07); }

  .compare-cell {
    display: flex;
    align-items: flex-start;
    gap: 0.75em;
    padding: clamp(0.9rem, 1.8vw, 1.25rem) clamp(1.1rem, 2.4vw, 1.9rem);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .compare-cell.is-old { color: #7c8595; }
  .compare-cell.is-old :global(svg) { color: #b9c0cb; margin-top: 0.3em; }

  .compare-cell.is-new {
    color: var(--ink-900);
    font-weight: 450;
    background: rgba(201, 162, 39, 0.05);
  }

  .compare-cell.is-new :global(svg) { color: var(--gold-600); margin-top: 0.3em; }

  @media (min-width: 780px) {
    .compare-head,
    .compare-row { grid-template-columns: 1fr 1fr; }
    .compare-cell.is-new { border-left: 1px solid rgba(201, 162, 39, 0.25); }
    .compare-h.is-new { border-left: 1px solid rgba(201, 162, 39, 0.25); }
  }
</style>
