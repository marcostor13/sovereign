# Variables que SÍ lee la aplicación en ejecución.
# (Las credenciales de despliegue viven aparte, en .env.deploy, y no se leen aquí.)
#
# Las variables PUBLIC_* se hornean en el HTML durante el build: en Docker/Coolify
# deben pasarse como build args. Las demás se leen en tiempo de ejecución.

# URL pública del sitio. Se usa en las etiquetas canónicas, Open Graph, el
# sitemap y robots.txt, así que debe coincidir con el dominio real.
PUBLIC_SITE_URL=https://sovereigncapitalsolutions.com

# Puerto y host del servidor Node.
HOST=0.0.0.0
PORT=4321

# --- Formulario de contacto ------------------------------------------------

# Opcional. Si se define, cada solicitud se reenvía como JSON a esta URL
# (Zapier, Make, n8n, un CRM o un webhook de Slack).
# CONTACT_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/000000/xxxxxx

# Dónde se registran las solicitudes recibidas (una línea JSON por solicitud).
CONTACT_LOG_PATH=./data/leads.jsonl

# --- Embudos /iul y /banca-mia ---------------------------------------------

# CRM (Maya, GoHighLevel, HubSpot vía Zapier/Make/n8n). Si falta, se usa
# CONTACT_WEBHOOK_URL. Cada evento lleva leadId, etapa y etiquetas.
# LEADS_WEBHOOK_URL=
LEADS_LOG_PATH=./data/funnels.jsonl

# Firma del token de acceso a la masterclass (cadena aleatoria larga).
# openssl rand -hex 32
# LEAD_TOKEN_SECRET=

# Agenda embebida (Cal.com o Calendly). Se lee en ejecución.
# PUBLIC_BOOKING_URL_IUL=https://cal.com/sovereign/consulta-iul
# PUBLIC_BOOKING_URL_WL=https://cal.com/sovereign/diagnostico-capital
# Webhook de Cal.com → /api/webhooks/booking (mismo secreto en Cal.com).
# CAL_WEBHOOK_SECRET=

# Guías PDF "de la A a la Z". Sin URL, el CRM las envía por email.
# GUIDE_URL_IUL=https://sovereigncapitalsolutions.com/guias/iul-a-z.pdf
# GUIDE_URL_WL=https://sovereigncapitalsolutions.com/guias/whole-life-a-z.pdf

# --- Medición (build) -------------------------------------------------------
# PUBLIC_META_PIXEL_ID=
# PUBLIC_GA4_ID=G-XXXXXXXXXX
# Conversions API (ejecución). Token de Events Manager.
# META_CAPI_TOKEN=
# META_TEST_EVENT_CODE=TEST12345

# --- Antispam ----------------------------------------------------------------
# Cloudflare Turnstile. Sin claves, quedan honeypot + límite por IP.
# PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Video (build) ------------------------------------------------------------
# IDs de Vimeo. Sin ellos se muestra la foto del asesor / aviso de publicación.
# PUBLIC_ADVISOR_VIDEO_IUL=
# PUBLIC_MASTERCLASS_VIMEO_ID=
# PUBLIC_THANKS_VIDEO_IUL=
# PUBLIC_THANKS_VIDEO_WL=
# PUBLIC_WHATSAPP_NUMBER=13055874200
